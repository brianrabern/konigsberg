# Copy to `.env` in the repo root (gitignored). Then:
#   llama-server ... --jinja --ctx-size 32768 -ngl 99
#   uv run konig --forever --max-rounds 20
#
# Full path: docs/LOCAL_BK_HUNT.md
KONIGSBERG_PROVIDER=local
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
KONIGSBERG_MODEL=Qwen2.5-Coder-32B-Instruct

# If ANTHROPIC_API_KEY is also set, KONIGSBERG_PROVIDER=local is mandatory
# or Claude wins the session.
#
# Qwen3 thinking: leave off (default). 16384 / 3600s if the server does not stream.
# KONIGSBERG_ENABLE_THINKING=0
# KONIGSBERG_MAX_TOKENS=16384
# KONIGSBERG_LLM_TIMEOUT=3600
#
# Live Π₂ caps (n=9 H??F~~~ SAT-hung the hunt). 0 disables.
# KONIGSBERG_CHOOSABILITY_MAX_N=6
# KONIGSBERG_CHOOSABILITY_TIMEOUT=45
