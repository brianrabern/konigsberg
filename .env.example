# Copy to repo-root `.env` (gitignored) and fill in. The CLI loads `.env`
# at startup; variables already in the shell win.
#
# Local llama.cpp hunt (recommended for --forever without a cloud key):
KONIGSBERG_PROVIDER=local
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
KONIGSBERG_MODEL=Qwen2.5-Coder-32B-Instruct

# If ANTHROPIC_API_KEY is also set, KONIGSBERG_PROVIDER=local is mandatory
# or Claude wins the session.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional local knobs
# KONIGSBERG_CHEAP_MODEL=Qwen2.5-Coder-32B-Instruct
# KONIGSBERG_LLM_TIMEOUT=600
# KONIGSBERG_MAX_TOKENS=8192
# KONIGSBERG_COMPACT_THRESHOLD=20000
# OPENAI_API_KEY=local
